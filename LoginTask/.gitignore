# Ignore all node_modules folders
node_modules/

# Ignore build output folders
build/
dist/
out/
.parcel-cache/ # If using Parcel bundler

# Ignore environment variable files (often sensitive)
.env
.env.local
.env.*.local

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*

# OS generated files
.DS_Store # macOS
Thumbs.db # Windows